+    description: 'Run target'
+    required: true
+runs:
+  using: "composite"
+  steps:
+    - run: |
+        source /tmp/ci_setup
+        bash -x $CI_ROOT/managers/debian.sh SETUP
+        bash -x $CI_ROOT/managers/debian.sh ${{ inputs.target }}
+        bash -x $CI_ROOT/managers/debian.sh CLEANUP
+      shell: bash
+
diff --git a/felix/bpf-gpl/libbpf/.github/actions/setup/action.yml b/felix/bpf-gpl/libbpf/.github/actions/setup/action.yml
new file mode 100644
