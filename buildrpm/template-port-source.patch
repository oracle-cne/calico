diff --git a/pod2daemon/node-driver-registrar/Dockerfile b/pod2daemon/node-driver-registrar/Dockerfile
new file mode 100644
--- /dev/null
+++ b/pod2daemon/node-driver-registrar/Dockerfile
@@ -0,0 +1,7 @@
+FROM gcr.io/distroless/static:latest
+LABEL maintainers="Kubernetes Authors"
+LABEL description="CSI Node driver registrar"
+ARG binary=./bin/csi-node-driver-registrar
+
+COPY ${binary} csi-node-driver-registrar
+ENTRYPOINT ["/csi-node-driver-registrar"]
